---
// Background-free figure on a morphing green shape, with floating result chips. Tilts with the pointer.
interface Chip { v: string; l: string; p?: 'tl' | 'tr' | 'bl' | 'br' | 'ml' | 'mr' }
interface Props { name: string; alt: string; ratio: number; chips?: Chip[]; tone?: 'deep' | 'mint' | 'bright'; size?: 'lg' | 'sm'; eager?: boolean; cls?: string }
const { name, alt, ratio, chips = [], tone = 'deep', size = 'lg', eager = false, cls = '' } = Astro.props;
const h = 1000, w = Math.round(h * ratio);
---
<div class={`cut cut-${tone} cut-${size} ${cls}`} data-tilt>
  <span class="cut-blob" aria-hidden="true"></span>
  <span class="cut-ring" aria-hidden="true"></span>
  <span class="cut-grid" aria-hidden="true"></span>
  <img class="cut-img" src={`/img/cut/${name}-560.webp`} srcset={`/img/cut/${name}-560.webp ${Math.round(560 * ratio)}w, /img/cut/${name}-1000.webp ${w}w`} sizes={size === 'sm' ? '(max-width: 700px) 45vw, 280px' : '(max-width: 900px) 80vw, 520px'} alt={alt} width={w} height={h} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  {chips.map((c, i) => <span class={`cut-chip c${i} p-${c.p ?? ['tl', 'br', 'tr'][i]}`}><b>{c.v}</b><span>{c.l}</span></span>)}
</div>
