---
import Logo from './Logo.astro';
import { SITE, SERVICES } from '../data/site';
---
<div class="eyesband" aria-hidden="true"><div class="semi" data-grow><span class="eye"><span class="pupil"></span></span><span class="eye"><span class="pupil"></span></span></div></div>
<footer class="foot">
  <div class="wrap">
    <p class="big">Let's grow your <em>revenue.</em></p>
    <div class="cols">
      <div>
        <a class="brand" href="/" style="color:#fff"><Logo size={32} /><span class="bt">The Grow Revenue <em>Company</em></span></a>
        <p style="margin-top:16px;max-width:36ch">A revenue-driven marketing company running paid ads, social media, content, lead generation, email marketing, funnels and AI automation for businesses in the US, UK, Canada and Europe.</p>
        <p><a href={'mailto:' + SITE.email}>{SITE.email}</a></p>
      </div>
      <div><h2>Services</h2><ul>{SERVICES.map((s) => <li><a href={'/' + s.slug + '/'}>{s.nav}</a></li>)}</ul></div>
      <div><h2>Company</h2><ul><li><a href="/about/">About</a></li><li><a href="/kunal-arora/">Kunal Arora</a></li><li><a href="/case-studies/">Case studies</a></li><li><a href="/contact/">Contact</a></li></ul></div>
      <div><h2>Policies</h2><ul><li><a href="/privacy/">Privacy policy</a></li><li><a href="/terms/">Terms of service</a></li><li><a href="/editorial-policy/">Editorial policy</a></li></ul></div>
    </div>
    <div class="legal">
      <span>&copy; 2026 {SITE.legalName}{SITE.companyNumber ? `, registered in England and Wales, company number ${SITE.companyNumber}` : ''}. {SITE.address.street}, {SITE.address.city} {SITE.address.postcode}, United Kingdom.</span>
      <span>Published by {SITE.name}</span>
    </div>
  </div>
</footer>
