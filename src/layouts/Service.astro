---
import Base from './Base.astro';
import Ribbon from '../components/Ribbon.astro';
import { SITE, svc, CASES, usd } from '../data/site';
interface Props {
  slug: string; title: string; description: string; h1: string; answer: string;
  mock?: string; cases: string[]; serviceType: string; faq?: [string, string][];
}
const { slug, title, description, h1, answer, cases, serviceType, faq = [] } = Astro.props;
const s = svc(slug);
const path = '/' + slug + '/';
const related = CASES.filter((c) => cases.includes(c.slug));
const people: Record<string, [string, string, string]> = {
  'paid-advertising': ['adsdesk', 'Media buyer watching ad performance graphs climb on two monitors', '800" height="450'],
  'social-media-marketing': ['streamer', 'Musician live streaming to followers from a home studio', '800" height="604'],
  'content-creation': ['editor', 'Video editor cutting a short vertical ad in a dark suite', '800" height="450'],
  'lead-generation': ['salescall', 'Saleswoman booking a sales meeting on a video call', '800" height="604'],
  'cold-email-infrastructure': ['b2bwindow', 'Consultant on a call with a prospect by a city window', '800" height="604'],
  'funnel-audit': ['strategists', 'Two strategists mapping funnel numbers late at night', '800" height="450'],
  'email-marketing': ['emailmacro', 'Hands building an email automation flow on a laptop', '800" height="450'],
  'ai-automation': ['aiwall', 'Man watching an AI workflow map light up on a wall', '800" height="450'],
  'email-deliverability': ['wallchart', 'Team reading inbox placement results on a wall screen', '800" height="450'],
};
const casePic: Record<string, string> = { 'synaps-dx': 'ecom', 'scalability': 'b2bwindow', 'maestro': 'streamer', 'soulful-evolution': 'coach', 'dimov-associates': 'lawyer', 'austere': 'artist' };
const [pic, picAlt] = people[slug] ?? people['email-marketing'];
const schema: object[] = [{
  '@type': 'Service', '@id': SITE.url + path + '#service', name: s.nav, serviceType, description,
  provider: { '@id': SITE.url + '/#org' }, areaServed: ['US', 'GB', 'CA', 'EU'], url: SITE.url + path,
  ...(s.tiers.length ? { offers: s.tiers.map((t) => ({ '@type': 'Offer', name: `${s.nav}: ${t.name}`, price: t.price, priceCurrency: 'USD', description: t.items, url: SITE.url + path + '#pricing' })) } : {}),
}];
if (faq.length) schema.push({ '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) });
---
<Base title={title} description={description} path={path} pageType="service" query={s.query} crumbs={[{ name: s.nav, path }]} schema={schema}>
  <section class="sh">
    <div class="wrap grid">
      <div>
        <span class="eyebrow">{s.group} &middot; {s.from ? `From ${usd(s.from)}` : 'Scoped to your account'}</span>
        <h1 data-split>{h1}</h1>
        <p class="lead">{answer}</p>
        <div class="btns">
          <a class="btn" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Book a 20 minute fit call</a>
          {s.tiers.length > 0 && <a class="btn ghost" href="#pricing">See prices</a>}
        </div>
      </div>
      <div class="art">
        <div class="p" data-wave="12" data-wavevar="--ry"><img src={`/img/cine/${pic}-800.webp`} srcset={`/img/cine/${pic}-800.webp 800w, /img/cine/${pic}-1600.webp 1600w`} sizes="(max-width: 900px) 80vw, 400px" alt={picAlt} width="800" height="600" /></div>
        <img class="ico" src={`/img/3d/${s.icon}.webp`} alt={`3D icon illustrating our ${s.query} work`} width="480" height="480" fetchpriority="high" data-wave="30" data-wavevar="--spin" />
      </div>
    </div>
  </section>

  <div class="over">
    <Ribbon />
    <section class="section">
      <div class="narrow prose">
        <slot />
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="grow" data-grow>
          <img src={`/img/cine/${pic}-1600.webp`} alt="" width="1600" height="900" loading="lazy" />
          <p class="cap">Planned, built and run by one team. <em>Measured by revenue.</em></p>
        </div>
      </div>
    </section>

    {s.tiers.length > 0 && (
      <section class="section" style="padding-top:0;background:var(--white)">
        <div class="narrow prose">
          <h2 id="pricing">How much does it cost?</h2>
          <p>Three fixed-price packages, scoped in writing before any work starts. Prices are in US dollars, as of October 26, 2026.</p>
        </div>
        <div class="wrap tiers3" data-stagger="90">
          {s.tiers.map((t, i) => (
            <div class={'tier' + (i === 1 ? ' mid' : '')} data-r="up">
              <h3>{t.name}</h3>
              <p class="price">{usd(t.price)} <small>{t.days} days</small></p>
              <p>{t.items}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="section" style="padding-top:0">
      <div class="narrow prose"><slot name="after" /></div>
      {faq.length > 0 && (
        <div class="wrap">
          <h2 class="center" data-split>Common <em>questions</em></h2>
          <div class="faqp" data-faq>
            <div class="fqs">{faq.map(([q], i) => <button class="fq" type="button" aria-controls={'fa' + i} aria-expanded={i === 0 ? 'true' : 'false'}>{q}</button>)}</div>
            <div class="fas">
              {faq.map(([q, a], i) => <div class={'fa' + (i === 0 ? ' on' : '')} id={'fa' + i}><h3>{q}</h3><p>{a}</p></div>)}
              <a class="btn dark" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Ask us something else</a>
            </div>
          </div>
        </div>
      )}
    </section>

    {related.length > 0 && (
      <section class="section" style="background:var(--cream)">
        <div class="wrap">
          <h2 class="center" data-split>Results from this <em>kind of work</em></h2>
          <div class="flipzone" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
            {related.map((c) => (
              <div class="fcard" data-cursor="Flip">
                <div class="fcard-inner">
                  <div class="fcard-front">
                    <img src={`/img/cine/${casePic[c.slug]}-800.webp`} alt="" width="800" height="604" loading="lazy" />
                    <span class="hint" aria-hidden="true">Turn over</span>
                    <div><strong>{c.results[0].value}</strong><p class="what">{c.results[0].metric}</p><div class="who">{c.client}<small>{c.industry}</small></div></div>
                  </div>
                  <div class="fcard-back">
                    {c.quote ? <><p>"{c.quote.text}"</p><small>{c.quote.who}</small></> : <p>{c.headline}.</p>}
                    <a href={'/case-studies/' + c.slug + '/'} style="margin-top:14px">Read the {c.client} case study &rarr;</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="wrap">
        <div class="cta reveal">
          <h2>Tell us what is happening. <em>We reply in a day.</em></h2>
          <p>You get a reply within one working day with a first read of your setup, before any call.</p>
          <div class="btns"><a class="btn" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Book a 20 minute fit call</a></div>
          <img class="ico" src={`/img/3d/${s.icon}.webp`} alt="" width="480" height="480" loading="lazy" data-parallax="0.1" />
        </div>
      </div>
    </section>
  </div>
</Base>
