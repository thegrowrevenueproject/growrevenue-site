---
import '../styles/global.css';
import '../styles/v2.css';
import '../styles/info.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
// content hash of the motion script: a new build can never run against an old cached copy
const mv = createHash('sha1').update(readFileSync(new URL('../../public/js/motion.js', import.meta.url))).digest('hex').slice(0, 10);

interface Crumb { name: string; path: string }
interface Props {
  title: string; description: string; path: string; pageType: string;
  crumbs?: Crumb[]; schema?: object[]; noindex?: boolean; ogImage?: string; darkHero?: boolean; query?: string;
}
const { title, description, path, pageType, crumbs = [], schema = [], noindex = false, ogImage = '/og/default.png', darkHero = false, query = '' } = Astro.props;
const url = SITE.url + path;
const sameAs = [SITE.linkedin].filter(Boolean);
const org = {
  '@type': 'Organization', '@id': SITE.url + '/#org', name: SITE.name, legalName: SITE.legalName, url: SITE.url,
  logo: SITE.url + '/logo.png', email: SITE.email,
  description: 'A revenue-driven marketing company in London that grows revenue through paid ads, social media, content, lead generation, email marketing, funnels and AI automation, measured by revenue.',
  slogan: 'Revenue-driven marketing', areaServed: ['US', 'GB', 'CA', 'EU'],
  knowsAbout: ['Paid advertising', 'PPC management', 'Social media marketing', 'Content creation', 'Lead generation', 'Cold email', 'Email marketing', 'Conversion funnels', 'Marketing automation', 'AI automation', 'Email deliverability'],
  address: { '@type': 'PostalAddress', streetAddress: SITE.address.street, addressLocality: SITE.address.city, postalCode: SITE.address.postcode, addressCountry: SITE.address.country },
  founder: { '@id': SITE.url + '/kunal-arora/#person' },
  ...(sameAs.length ? { sameAs } : {}),
};
const website = { '@type': 'WebSite', '@id': SITE.url + '/#website', name: SITE.name, url: SITE.url, publisher: { '@id': SITE.url + '/#org' }, inLanguage: 'en-US' };
const webpage = { '@type': 'WebPage', '@id': url + '#webpage', url, name: title, description, isPartOf: { '@id': SITE.url + '/#website' }, inLanguage: 'en-US' };
const graph: object[] = [org, website, webpage, ...schema];
if (crumbs.length) {
  graph.push({ '@type': 'BreadcrumbList', '@id': url + '#breadcrumb', itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE.url + c.path })) });
}
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="page_type" content={pageType} />
  {query && <meta name="gr:query" content={query} />}
  <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/instrument-italic.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    /* Content is hidden for entrance animations only while the motion script is confirmed running.
       If it fails to load, errors, or is late, everything is shown immediately. */
    (function (r) {
      var ok = 0, off = function () { if (!ok) r.classList.remove('js'); };
      r.classList.add('js');
      window.__grm = function () { ok = 1; };
      document.addEventListener('DOMContentLoaded', off);
      setTimeout(off, 5000);
      window.addEventListener('error', function (e) { var t = e.target; if ((t && t.tagName === 'SCRIPT') || (e.filename && e.filename.indexOf('/js/motion.js') > -1)) r.classList.remove('js'); }, true);
    })(document.documentElement);
  </script>
  <script defer src={`/js/motion.js?v=${mv}`}></script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title="The Grow Revenue Company blog" href="/rss.xml" />
  <meta name="theme-color" content="#07110C" />
  <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={SITE.url + ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={SITE.url + ogImage} />
  <script type="application/ld+json" set:html={ld} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header dark={darkHero} />
  <main id="main">
    {crumbs.length > 0 && (
      <nav class="wrap crumbs" aria-label="Breadcrumb" style="padding-top:100px;margin-bottom:-120px;position:relative;z-index:2">
        <a href="/">Home</a>{crumbs.map((c, i) => <> / {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</>)}
      </nav>
    )}
    <slot />
  </main>
  <Footer />
</body>
</html>
