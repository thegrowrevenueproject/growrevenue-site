---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
const sameAs = [SITE.linkedin].filter(Boolean);
const schema = [{ '@type': 'Person', '@id': SITE.url + '/kunal-arora/#person', name: 'Kunal Arora', url: SITE.url + '/kunal-arora/', image: SITE.url + '/img/kunal-arora.webp', jobTitle: 'Founder, growth marketer', worksFor: { '@id': SITE.url + '/#org' }, knowsAbout: ['Growth marketing', 'Email marketing', 'Lead generation', 'Paid advertising', 'Sales funnels', 'Marketing automation', 'Email deliverability'], ...(sameAs.length ? { sameAs } : {}) }];
---
<Base title="Kunal Arora, Founder and Growth Marketer | Grow Revenue"
  description="Kunal Arora founded The Grow Revenue Company and has delivered 123 client projects across paid ads, email, lead generation, funnels and AI automation."
  path="/kunal-arora/" pageType="author" schema={schema} crumbs={[{ name: 'About', path: '/about/' }, { name: 'Kunal Arora', path: '/kunal-arora/' }]}>
  <section class="section" style="padding-top:150px">
    <div class="narrow prose">
      <img src="/img/kunal-arora.webp" alt="Portrait photo of Kunal Arora, founder of The Grow Revenue Company" width="160" height="160" style="border-radius:50%;width:160px;height:160px;margin-bottom:20px" />
      <h1 style="font-size:clamp(2.2rem,5vw,3.4rem)">Kunal Arora, founder and growth marketer</h1>
      <p class="lead">Kunal Arora founded The Grow Revenue Company and has delivered 123 client projects across more than 8,700 hours of client work. He writes every article on this site.</p>
      <h2>What does Kunal work on?</h2>
      <p>Growth strategy across paid ads, lead generation, email marketing, funnels and AI automation, with deep specialist knowledge of email deliverability and cold email infrastructure. He has worked in marketing for over eleven years.</p>
      <h2>Products he builds</h2>
      <p>OutPumper, an Outlook add-in for sending outreach from your own Microsoft 365 mailboxes.</p>
      <h2>Where to find him</h2>
      <ul>
        {SITE.linkedin && <li><a href={SITE.linkedin} rel="me noopener">LinkedIn</a></li>}
        <li><a href={'mailto:' + SITE.email}>{SITE.email}</a></li>
      </ul>
    </div>
  </section>
</Base>
