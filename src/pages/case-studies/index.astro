---
import Base from '../../layouts/Base.astro';
import { CASES } from '../../data/site';
---
<Base title="Marketing Case Studies: Revenue We Have Grown | Grow Revenue"
  description="Six marketing case studies with the revenue results: 40% online revenue growth, $500K in new annual revenue, 3.5x return on ad spend and 3x lead volume."
  path="/case-studies/" pageType="hub" crumbs={[{ name: 'Case studies', path: '/case-studies/' }]}>
  <section class="phero">
    <div class="wrap">
      <h1 style="max-width:20ch">Marketing case studies: the revenue we have grown for clients</h1>
      <p class="lead">Six client projects across ecommerce, B2B services, a creator platform, coaching, legal and marketing services. Each page shows the starting point, what we changed and the measured result, with the period it was measured over.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="wrap grid3">
      {CASES.map((c) => (
        <article class="card case">
          <span class="tag">{c.client} &middot; {c.industry}</span>
          <h2 style="font-size:1.45rem"><a href={'/case-studies/' + c.slug + '/'}>{c.headline}</a></h2>
          <ul class="nums">{c.results.slice(0, 3).map((r) => <li>{r.metric}: <strong>{r.value}</strong></li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</Base>
