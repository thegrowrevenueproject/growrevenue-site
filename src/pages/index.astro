---
import Base from '../layouts/Base.astro';
import Ribbon from '../components/Ribbon.astro';
import * as si from 'simple-icons';
import { SERVICES, GROUPS, CASES, REVENUE_PROOF } from '../data/site';
import { CASE_BODY } from '../data/cases';
const Q = 'marketing company';
const faq: [string, string][] = [
  ['What does a revenue-driven marketing company do?', 'It plans and runs the channels that bring in customers, then judges each one by the revenue it produces. For us that means paid ads, social media, content, lead generation, email marketing, funnels and AI automation, built to feed each other instead of competing for budget.'],
  ['How is that different from a typical marketing supplier?', 'A typical supplier reports the metric of its own channel: clicks, followers or opens. We report revenue first and the numbers that lead to it, and we move budget away from anything that does not pay for itself.'],
  ['How do you measure success?', 'By revenue and the numbers that lead to it: cost per lead, cost per customer, lead to sale conversion and email revenue share. Every project starts with a baseline, so the before and after are measured, not estimated.'],
  ['Do I need every service?', 'No. Most clients start with the one or two channels where the gap is biggest, often a leaking funnel or an email list that earns nothing. We add channels only when the first ones pay for themselves.'],
  ['How much does it cost?', 'Fixed-price packages start at $350 for a deliverability audit, $500 for a funnel audit and $600 for a cold email setup. Ongoing marketing is scoped to your goals after a free 20 minute call, with a fixed monthly fee.'],
  ['Where are you based?', 'London, United Kingdom. We work with businesses in the US, UK, Canada and Europe, mostly in their own time zones.'],
];
const schema = [{ '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
const ic = (k: string) => (si as any)[k]?.path as string;
const trail = ['siInstagram', 'siTiktok', 'siYoutube', 'siMeta', 'siGoogleads', 'siHubspot', 'siGmail', 'siShopify'].map(ic).filter(Boolean);
const stageStyle = ['c1', 'c2', 'c3', 'c4'];
const stagePoints: Record<string, string[]> = {
  Attract: ['Google Ads', 'Meta Ads', 'TikTok', 'Instagram', 'YouTube', 'Short-form video'],
  Capture: ['Cold email', 'LinkedIn outreach', 'Lead magnets', 'Landing pages', 'Booked calls'],
  Convert: ['Funnel audits', 'Welcome flows', 'Abandoned cart', 'Win-back', 'CRM routing'],
  Scale: ['n8n', 'Make', 'Zapier', 'AI agents', 'Inbox placement', 'Reporting'],
};
const proofPics: [string, string][] = [
  ['ecom', 'Photographer shooting skincare products for an online store at night'],
  ['coach', 'Coach leading a small workshop group in a dark loft'],
  ['adsdesk', 'Media buyer watching ad performance graphs climb on two monitors'],
  ['lawyer', 'Lawyer reading a lead report on a tablet in her office'],
];
const casePics: Record<string, [string, string]> = {
  'synaps-dx': ['ecom', 'Product photo shoot for an online health brand at night'],
  'scalability': ['b2bwindow', 'B2B consultant on a sales call by a city window at night'],
  'maestro': ['streamer', 'Musician live streaming from a home studio with a ring light'],
  'soulful-evolution': ['coach', 'Coach running a small group workshop in a dark loft'],
  'dimov-associates': ['lawyer', 'Lawyer reviewing a lead report on a tablet at dusk'],
  'austere': ['artist', 'Painter checking social media results on her phone in her studio'],
};
const short: Record<string, string> = { 'paid-advertising': 'Paid ads', 'social-media-marketing': 'Social media', 'content-creation': 'Content', 'lead-generation': 'Lead generation', 'cold-email-infrastructure': 'Cold email', 'funnel-audit': 'Funnels', 'email-marketing': 'Email marketing', 'ai-automation': 'AI automation', 'email-deliverability': 'Deliverability' };
const flips = [
  { slug: 'synaps-dx', big: '40%', what: 'growth in online revenue', who: 'Synaps Dx', role: 'Ecommerce', quote: CASES[0].quote },
  { slug: 'scalability', big: '150+', what: 'qualified leads a month', who: 'Scalability', role: 'B2B services', quote: CASES[1].quote },
  { slug: 'dimov-associates', big: '3x', what: 'lead volume at 40% lower cost per acquisition', who: 'Dimov Associates', role: 'Legal', quote: CASES[4].quote },
  { slug: 'soulful-evolution', big: '$500K', what: 'new annual revenue', who: 'Soulful Evolution', role: 'Coaching', text: 'Program sign-ups rose 60%, with 300+ leads a month coming in across LinkedIn, Google Ads and email nurture.' },
  { slug: 'maestro', big: '+65%', what: 'creator sign-ups', who: 'Maestro', role: 'Creator platform', text: 'Segmented cold email and LinkedIn reached 200,000+ potential users at a 42% open rate.' },
  { slug: 'austere', big: '3.5x', what: 'return on ad spend', who: 'Austere', role: 'Marketing services', text: 'Ads matched to landing pages produced 450+ qualified leads in one quarter at an 18% lower cost per click.' },
];
const team = [
  { name: 'Barbara Arora', role: 'Co-founder. Client strategy, social media and campaign planning.', img: '/img/barbara-arora.webp', href: '/about/' },
  { name: 'Kunal Arora', role: 'Founder. Growth strategy, email, outreach and automation.', img: '/img/kunal-arora.webp', href: '/kunal-arora/' },
  { name: 'Rahul Arora', role: 'Creative director. Ad creative, video, design and landing pages.', img: '/img/rahul-arora.webp', href: '/about/' },
];
const mark = '<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M13 51A7 7 0 0 1 20 44V51Z" fill="#2B8A5C"/><path d="M20 44A12 12 0 0 1 32 32V44Z" fill="#43C483"/><path d="M32 32A19 19 0 0 1 51 13V32Z" fill="#A6F2C8"/></svg>';
const vid = (n: string, label: string) => `<video muted loop playsinline preload="none" poster="/video/sq-${n}.webp" data-lazy aria-hidden="true"><source data-src="/video/sq-${n}.webm" type="video/webm" /><source data-src="/video/sq-${n}.mp4" type="video/mp4" /></video><span class="lab">${label}</span>`;
---
<Base title="Revenue-Driven Marketing Company in London | Grow Revenue"
  description="The Grow Revenue Company is a revenue-driven marketing company in London running paid ads, social, content, lead generation, email and AI automation."
  path="/" pageType="home" query={Q} schema={schema} ogImage="/og/home.png">

  <!-- 1. Pinned hero: typewriter headline, video cube turning with scroll, icons travelling a curved path -->
  <section class="h2-hero" data-pin-hero>
    <div class="wrap inner grid">
      <div>
        <span class="eyebrow">Revenue-driven marketing &middot; London</span>
        <h1 data-split>The revenue-driven marketing company built to grow your <em data-type="revenue.|pipeline.|sales.|margins.">revenue.</em></h1>
        <p class="lead">The Grow Revenue Company is a revenue-driven marketing company. We run paid ads, social media, content, lead generation, email marketing, funnels and AI automation as one system, and report one number first: the revenue it brings in.</p>
        <div class="btns">
          <a class="btn" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Book a 20 minute growth call</a>
          <a class="btn ghost" href="/case-studies/">See the revenue results</a>
        </div>
      </div>
      <div class="hstage">
        <svg class="trail" viewBox="0 0 800 800" aria-hidden="true">
          <path id="trailPath" class="path" d="M-40 640 C 120 520, 220 780, 420 700 S 720 420, 860 120" />
          {trail.map((p, i) => (
            <g class="bub"><circle r="26" /><g transform="translate(-13 -13) scale(1.0833)"><path d={p} /></g>
              <animateMotion dur="24s" repeatCount="indefinite" begin={`-${(i * 3).toFixed(1)}s`}><mpath href="#trailPath" /></animateMotion></g>
          ))}
        </svg>
        <div class="vcube" data-spin="ry:-24:300;rx:-14:6" data-idle="ry:5" data-src="page" data-drag data-cursor="Drag" role="img" aria-label="A turning cube of short films: a media buyer reading ad results, a podcast recording, a creator filming and an AI workflow map">
          <div class="p3d">
            <div class="face f1" set:html={vid('ads', 'Paid ads')} />
            <div class="face f2" set:html={vid('podcast', 'Content')} />
            <div class="face f3" set:html={vid('creator', 'Social')} />
            <div class="face f4" set:html={vid('aiwall', 'AI automation')} />
            <div class="face f5" set:html={mark} />
            <div class="face f6" set:html={mark} />
          </div>
        </div>
        <div class="chip3 c1"><span><strong>3.5x</strong>return on ad spend</span></div>
        <div class="chip3 c2"><span><strong>$500K</strong>new annual revenue</span></div>
      </div>
    </div>
  </section>

  <div class="over">
    <Ribbon />

    <!-- 2. About curtain -->
    <section class="curtain" aria-labelledby="about-h">
      <div class="wrap">
        <div class="row reveal">
          <p>We help ambitious businesses grow revenue with paid ads, social media, content, outreach and email that work as one plan.</p>
          <img src="/img/cine/strategists-800.webp" alt="Two strategists reviewing funnel charts late at night" width="800" height="450" loading="lazy" />
          <h2 id="about-h">About <em>us</em></h2>
          <img src="/img/cine/salescall-800.webp" alt="Saleswoman on a video call in a glass meeting room" width="800" height="604" loading="lazy" />
          <p class="r">From the first ad to the repeat purchase, we turn attention into pipeline and pipeline into sales, one measured step at a time.</p>
        </div>
        <p class="statement" data-scrub>We judge every ad, post and email by <em>the revenue it brings in</em>, and we cut whatever does not earn its place.</p>
        <div class="btns"><a class="btn" href="/about/"><span class="arr" aria-hidden="true">&#8599;</span>Meet the company</a></div>
      </div>
    </section>

    <div class="ticker" aria-label="Recent client results">
      <span class="lab">Results</span>
      <div class="marquee">
        {[0, 1].map((dup) => (
          <div class="track" aria-hidden={dup ? 'true' : undefined}>
            <span><b>Synaps Dx</b> online revenue up 40%</span><span><b>Scalability</b> 50+ sales consultations in 3 months</span><span><b>Soulful Evolution</b> $500K new annual revenue</span><span><b>Dimov Associates</b> 3x leads at 40% lower cost</span><span><b>Austere</b> 3.5x return on ad spend</span><span><b>Maestro</b> 65% more creator sign-ups</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. Proof: spinning coin + stat rows -->
    <section class="section">
      <div class="wrap">
        <div class="proofgrid">
          <div>
            <span class="eyebrow">Proof</span>
            <h2 data-split>What revenue have <em>clients</em> seen?</h2>
            <p class="lead reveal">Four numbers from published case studies. Each one links to the full story, with the starting point and the period it was measured over.</p>
          </div>
          <div class="coin" data-spin="ry:-60:600;rx:10:-10" data-idle="ry:10" aria-hidden="true">
            <div class="p3d">{Array.from({ length: 24 }, (_, n) => <i class="rim" style={`--n:${n}`}></i>)}<div class="cf"><b>$</b></div><div class="cf cb" set:html={mark} /></div>
          </div>
        </div>
        <ul class="srows">
          {REVENUE_PROOF.map((r, i) => (
            <li class="srow reveal">
              <strong data-count={r.value} data-pre={r.pre} data-suf={r.suf} data-dec={String(r.value).includes('.') ? '1' : '0'}>{r.pre}{r.value}{r.suf}</strong>
              <p><b>{r.label}</b><a href={'/case-studies/' + r.slug + '/'}>{r.client} case study &rarr;</a></p>
              <div class="pic" data-zoom><img src={`/img/cine/${proofPics[i][0]}-800.webp`} alt={proofPics[i][1]} width="800" height="604" loading="lazy" /></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Definition block for answer engines -->
    <section class="section" style="background:var(--paper)">
      <div class="narrow">
        <span class="eyebrow">The short answer</span>
        <h2 data-split>What is a revenue-driven <em>marketing company?</em></h2>
        <p class="reveal">A revenue-driven marketing company plans, runs and reports every channel against the revenue it produces, not against clicks, followers or opens. It sets a baseline before any work starts, connects ads, content, outreach and email into one path to purchase, and moves budget to whatever earns. That is the only way we work.</p>
        <div class="table-wrap reveal"><table>
          <caption>How we differ from a channel-by-channel supplier</caption>
          <thead><tr><th>Question</th><th>Channel supplier</th><th>Revenue-driven</th></tr></thead>
          <tbody>
            <tr><td>What gets reported?</td><td>Clicks, reach, followers, opens</td><td>Revenue, cost per customer, pipeline</td></tr>
            <tr><td>Who owns the gaps between channels?</td><td>Nobody</td><td>We do: one plan, one team</td></tr>
            <tr><td>When is a channel cut?</td><td>When the contract ends</td><td>When it stops paying for itself</td></tr>
            <tr><td>Who owns the accounts and data?</td><td>Often the supplier</td><td>You, always</td></tr>
          </tbody>
        </table></div>
      </div>
    </section>

    <!-- 5. Services: stage cards stack over each other, then a 3D ring of every service turns with scroll -->
    <section class="section" style="background:var(--cream)">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Services</span>
          <h2 data-split>What do we run <em>for your revenue?</em></h2>
          <p class="lead reveal">The full path from a stranger's first look to their repeat purchase: nine services in four stages, each one starting from a measured baseline.</p>
        </div>
        <div class="stack" data-stack>
          {GROUPS.map((g, i) => (
            <article class={'stack-card ' + stageStyle[i]} style={`--i:${i}`}>
              <div>
                <span class="k">0{i + 1} {g.name}</span>
                <h3>{g.line}</h3>
                <ul class="sl">
                  {SERVICES.filter((s) => s.group === g.name).map((s) => (
                    <li><a href={'/' + s.slug + '/'}><img src={`/img/3d/${s.icon}.webp`} alt="" width="48" height="48" loading="lazy" /><span><b>{s.nav}</b><small>{s.blurb.split('. ')[0].replace(/\.$/, '')}.</small></span></a></li>
                  ))}
                </ul>
                <ul class="chips" aria-label={g.name + ' tools and tactics'}>{stagePoints[g.name].map((c) => <li>{c}</li>)}</ul>
              </div>
              <div class="mock" aria-hidden="true">
                {g.name === 'Attract' && <>
                  <div class="tile"><small>Return on ad spend</small><b>3.5x</b><span class="up">&#9650; vs last quarter</span></div>
                  <div class="tile"><small>Cost per customer</small><b>$41</b><span class="up">&#9660; 22%</span></div>
                  <div class="tile w"><small>Revenue by week</small><div class="bars"><i style="--h:30%"></i><i style="--h:44%"></i><i style="--h:38%"></i><i style="--h:56%"></i><i style="--h:62%"></i><i style="--h:58%"></i><i style="--h:74%"></i><i style="--h:88%"></i><i style="--h:96%"></i></div></div>
                  <div class="tile w"><div class="rowi"><span class="dot">G</span>Search, brand terms<span class="pill">5.1x</span></div><div class="rowi"><span class="dot">M</span>Meta, video retargeting<span class="pill">3.8x</span></div><div class="rowi"><span class="dot">T</span>TikTok, creator ads<span class="pill g">testing</span></div></div>
                </>}
                {g.name === 'Capture' && <>
                  <div class="tile"><small>Qualified leads</small><b>150+</b><span class="up">per month</span></div>
                  <div class="tile"><small>Reply rate</small><b>11.4%</b><span class="up">&#9650; 3.2 pts</span></div>
                  <div class="tile w"><small>This week's booked calls</small><div class="rowi"><span class="dot">AC</span>Head of Growth, SaaS<span class="pill">Tue 10:00</span></div><div class="rowi"><span class="dot">JR</span>Founder, law firm<span class="pill">Wed 15:30</span></div><div class="rowi"><span class="dot">MK</span>COO, ecommerce<span class="pill">Thu 09:00</span></div><div class="rowi"><span class="dot">SL</span>VP Sales, B2B<span class="pill g">confirmed</span></div></div>
                </>}
                {g.name === 'Convert' && <>
                  <div class="tile w"><small>Email share of online revenue</small><b>38%+</b><svg class="spark" viewBox="0 0 300 60" preserveAspectRatio="none"><path d="M0 55 C 40 52, 60 48, 90 44 S 150 30, 180 26 S 240 12, 300 6" /></svg></div>
                  <div class="tile"><small>Open rate</small><b>35%</b><span class="up">from 18%</span></div>
                  <div class="tile"><small>Click rate</small><b>3.2%</b><span class="up">from 1.5%</span></div>
                  <div class="tile w"><small>Live flows</small><div class="flow"><span>Sign-up</span><i></i><span>Welcome</span><i></i><span>Cart</span><i></i><span>Win-back</span></div></div>
                </>}
                {g.name === 'Scale' && <>
                  <div class="tile w"><small>AI agent: reply triage</small><div class="flow"><span>Inbox</span><i></i><span>Classify</span><i></i><span>Draft</span><i></i><span>Human OK</span><i></i><span>CRM</span></div></div>
                  <div class="tile"><small>Hours saved a week</small><b>14</b><span class="up">per team</span></div>
                  <div class="tile"><small>Inbox placement</small><b>96%</b><span class="up">Gmail and Outlook</span></div>
                  <div class="tile w"><div class="rowi"><span class="dot">n8n</span>Lead research workflow<span class="pill g">running</span></div><div class="rowi"><span class="dot">AI</span>Weekly revenue report<span class="pill">Mon 08:00</span></div></div>
                </>}
              </div>
            </article>
          ))}
        </div>
        <nav class="ring3d" data-spin="ry:40:-320" data-idle="ry:-3" aria-label="All services">
          <div class="p3d">
            {SERVICES.map((s, k) => <a href={'/' + s.slug + '/'} style={`--k:${k}`}><img src={`/img/3d/${s.icon}.webp`} alt="" width="104" height="104" loading="lazy" />{short[s.slug]}<small>{s.from ? `from $${s.from}` : 'scoped'}</small></a>)}
          </div>
        </nav>
        <p class="note center" style="margin-top:30px">Dashboard figures on the cards illustrate what we report. Client results are on the case study pages.</p>
      </div>
    </section>

    <!-- 6. AI era: gyroscope rings turning with scroll -->
    <section class="section dark">
      <div class="wrap">
        <div class="era2">
          <div>
            <span class="eyebrow">Marketing in the AI era</span>
            <h2 data-split>AI made marketing cheap to make. <em>Growth</em> is still hard to earn.</h2>
            <p class="lead reveal">Anyone can now produce a thousand ads, posts and emails in an afternoon, so feeds and inboxes are flooded and attention costs more every year. The businesses that grow connect every channel into one engine, use AI for the busywork, and keep people on strategy, creative and judgment. That engine is what we build.</p>
            <div class="btns reveal"><a class="btn" href="/ai-automation/"><span class="arr" aria-hidden="true">&#8599;</span>See our AI automation</a></div>
          </div>
          <div class="gyro" aria-hidden="true">
            <div class="p3d r1" data-spin="rx:70:70;ry:0:420" data-idle="ry:14"><i></i></div>
            <div class="p3d r2" data-spin="rx:-55:-55;ry:0:-360" data-idle="ry:-10"><i></i></div>
            <div class="p3d r3" data-spin="rx:10:190;rz:0:220" data-idle="rz:8"><i></i></div>
            <img src="/img/3d/ai.webp" alt="" width="480" height="480" loading="lazy" />
          </div>
        </div>
        <div class="era">
          <div class="reveal">
            <h3>How marketing used to work</h3>
            <ul>
              <li>Separate suppliers for ads, social, email and the website</li>
              <li>Each one reporting its own vanity metric: clicks, likes, opens</li>
              <li>Leads handed to sales with no follow-up system behind them</li>
              <li>Reports stitched together by hand at month end</li>
            </ul>
          </div>
          <div class="now reveal d1">
            <h3>How growth works now</h3>
            <ul>
              <li>One plan where ads, content and outreach all feed the same funnel</li>
              <li>Every channel judged by cost per customer and revenue, not reach</li>
              <li>Email and automation turn every lead into a long-term buyer</li>
              <li>AI agents research, sort, follow up and report around the clock</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Coverflow strip: what we make -->
    <section class="hs" data-hscroll aria-labelledby="make-h">
      <div class="stick">
        <div class="wrap">
          <span class="eyebrow">Inside the work</span>
          <h2 id="make-h" data-split>What do we make <em>every month?</em></h2>
        </div>
        <div class="htrack">
          <article class="hcard"><div class="m"><span class="n">Video</span><video muted loop playsinline preload="none" poster="/video/sq-creator.webp" data-lazy aria-label="Creator filming a product video on a phone gimbal"><source data-src="/video/sq-creator.webm" type="video/webm" /><source data-src="/video/sq-creator.mp4" type="video/mp4" /></video></div><div class="t"><h3>Short-form video</h3><p>Hooks, scripts and edits for Reels, TikTok and Shorts, planned around what your buyers search for.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">Ads</span><img src="/img/cine/editor-800.webp" alt="Video editor cutting a short vertical ad in a dark suite" width="800" height="450" loading="lazy" /></div><div class="t"><h3>Ad creative and landing pages</h3><p>Static, video and motion ads with the page they point to, tested against cost per customer.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">Social</span><img src="/img/cine/streamer-800.webp" alt="Musician live streaming to followers from a home studio" width="800" height="604" loading="lazy" /></div><div class="t"><h3>Social content</h3><p>Carousels, posts and creator content on a calendar, with every post pointing somewhere useful.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">Email</span><img src="/img/cine/emailmacro-800.webp" alt="Hands typing beside an email automation flow on a laptop" width="800" height="450" loading="lazy" /></div><div class="t"><h3>Email flows and campaigns</h3><p>Welcome, cart, post-purchase and win-back flows that keep selling after the first order.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">Leads</span><img src="/img/cine/salescall-800.webp" alt="Saleswoman booking a meeting on a video call at night" width="800" height="604" loading="lazy" /></div><div class="t"><h3>Outreach that books calls</h3><p>Lead lists, cold email and LinkedIn sequences that fill your calendar with buyers.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">Podcast</span><video muted loop playsinline preload="none" poster="/video/sq-podcast.webp" data-lazy aria-label="Two hosts recording a business podcast"><source data-src="/video/sq-podcast.webm" type="video/webm" /><source data-src="/video/sq-podcast.mp4" type="video/mp4" /></video></div><div class="t"><h3>Podcasts and long-form</h3><p>Episodes and articles cut into a month of posts, emails and ads from one recording.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">AI</span><video muted loop playsinline preload="none" poster="/video/sq-aiwall.webp" data-lazy aria-label="Man watching an AI workflow map light up on a wall"><source data-src="/video/sq-aiwall.webm" type="video/webm" /><source data-src="/video/sq-aiwall.mp4" type="video/mp4" /></video></div><div class="t"><h3>AI agents and automations</h3><p>Workflows that research leads, sort replies, update the CRM and write the weekly report.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">Reports</span><img src="/img/cine/wallchart-800.webp" alt="Team reading a revenue chart on a large wall screen" width="800" height="450" loading="lazy" /></div><div class="t"><h3>Revenue reports</h3><p>One monthly report that ties spend in every channel to the sales it produced.</p></div></article>
        </div>
      </div>
    </section>

    <!-- 8. Case studies: tabs by client -->
    <section class="section">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Case studies</span>
          <h2 data-split>Real work. <em>Real revenue.</em></h2>
          <p class="lead reveal">Ecommerce, B2B services, coaching, legal and creator platforms. Pick a client to see what changed and what it earned.</p>
        </div>
        <div data-tabs>
          <div class="tabs" role="tablist" aria-label="Client case studies">
