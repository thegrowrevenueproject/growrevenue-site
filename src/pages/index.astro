---
import Base from '../layouts/Base.astro';
import Ribbon from '../components/Ribbon.astro';
import { SERVICES, GROUPS, CASES, REVENUE_PROOF, usd } from '../data/site';
const Q = 'growth marketing agency';
const faq = [
  ['What does a growth marketing agency do?', 'It plans and runs every channel that brings in customers, then judges each one by the revenue it produces. For us that means paid ads, social media, content, lead generation, email marketing, funnels and AI automation, built to feed each other instead of competing for budget.'],
  ['How do you measure success?', 'By revenue and the numbers that lead to it: cost per lead, cost per customer, lead to sale conversion and email revenue share. Every project starts with a baseline, so the before and after are measured, not estimated.'],
  ['Do I need every service?', 'No. Most clients start with the one or two channels where the gap is biggest, often a leaking funnel or an email list that earns nothing. We add channels only when the first ones pay for themselves.'],
  ['How much does it cost?', 'Fixed-price packages start at $350 for a deliverability audit, $500 for a funnel audit and $600 for a cold email setup. Ongoing marketing is scoped to your goals after a free 20 minute call, with a fixed monthly fee.'],
  ['Where are you based?', 'London, United Kingdom. We work with businesses in the US, UK, Canada and Europe, mostly in their own time zones.'],
];
const schema = [{ '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
const ring = SERVICES.map((s, i) => {
  const a = (-90 + (360 / SERVICES.length) * i) * Math.PI / 180;
  return { ...s, x: +(50 + 40 * Math.cos(a)).toFixed(2), y: +(50 + 41 * Math.sin(a)).toFixed(2) };
});
const short: Record<string, string> = { 'paid-advertising': 'Paid ads', 'social-media-marketing': 'Social media', 'content-creation': 'Content', 'lead-generation': 'Lead generation', 'cold-email-infrastructure': 'Cold email', 'funnel-audit': 'Funnels', 'email-marketing': 'Email marketing', 'ai-automation': 'AI automation', 'email-deliverability': 'Deliverability' };
---
<Base title="Growth Marketing Agency That Grows Revenue | Grow Revenue"
  description="Growth marketing agency running paid ads, social media, content, lead generation, email, funnels and AI automation as one system built to grow your revenue."
  path="/" pageType="home" query={Q} schema={schema} ogImage="/og/home.png" darkHero>

  <section class="hero on-dark">
    <img class="poster" src="/video/hero-poster.webp" alt="" width="1280" height="720" fetchpriority="high" />
    <video autoplay muted loop playsinline preload="none" poster="/video/hero-poster.webp" data-lazy aria-hidden="true">
      <source data-src="/video/hero.webm" type="video/webm" />
      <source data-src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="wrap grid">
      <div>
        <span class="eyebrow">London &middot; US, UK, Canada and Europe</span>
        <h1 data-split>The growth marketing agency built to grow your <em class="rotator"><span>revenue.</span><span>pipeline.</span><span>sales.</span><span>margins.</span></em></h1>
        <p class="lead reveal d1">We are a growth marketing agency, and revenue is the number we report on. Paid ads, social media, content, lead generation, email marketing, funnels and AI automation run as one system, so every channel feeds the next and you can see what each one earns.</p>
        <div class="btns reveal d2">
          <a class="btn" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Book a 20 minute growth call</a>
          <a class="btn ghost" href="/case-studies/">See the revenue results</a>
        </div>
        <ul class="proof reveal d3" aria-label="Client results">
          <li><strong>40%</strong> online revenue growth</li><li><strong>$500K</strong> new annual revenue</li><li><strong>3.5x</strong> return on ad spend</li>
        </ul>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img class="a1" src="/img/3d/growth.webp" alt="" width="480" height="480" data-parallax="0.12" />
        <img class="a2" src="/img/3d/ads.webp" alt="" width="480" height="480" data-parallax="0.28" />
        <img class="a3" src="/img/3d/magnet.webp" alt="" width="480" height="480" data-parallax="0.2" />
        <img class="a4" src="/img/3d/social.webp" alt="" width="480" height="480" data-parallax="0.34" />
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true"></span>
  </section>

  <Ribbon />

  <section class="stats" aria-label="Revenue results from client case studies">
    <ul class="strip wrap">
      {REVENUE_PROOF.map((r) => (
        <li><strong data-count={r.value} data-pre={r.pre} data-suf={r.suf} data-dec={String(r.value).includes('.') ? '1' : '0'}>{r.pre}{r.value}{r.suf}</strong>{r.label} <a href={'/case-studies/' + r.slug + '/'} style="color:inherit;font-weight:700">{r.client} &rarr;</a></li>
      ))}
    </ul>
  </section>

  <section class="section dark">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">Marketing in the AI era</span>
        <h2 data-split>AI made marketing cheap to make. <em>Growth</em> is still hard to earn.</h2>
        <p class="lead reveal">Anyone can now produce a thousand ads, posts and emails in an afternoon, so feeds and inboxes are flooded and attention costs more every year. The businesses that grow connect every channel into one engine and measure it by revenue. That engine is what we build.</p>
      </div>
      <div class="engine reveal" style="margin-top:40px" role="img" aria-label="Diagram: your revenue at the center, connected to paid ads, social media, content, lead generation, cold email, funnels, email marketing, AI automation and deliverability">
        <svg class="wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {ring.map((n) => <path class="wire" d={`M50 50 Q ${(50 + n.x) / 2 + (n.y - 50) * 0.15} ${(50 + n.y) / 2 - (n.x - 50) * 0.15} ${n.x} ${n.y}`} vector-effect="non-scaling-stroke" />)}
        </svg>
        <a class="node hub" href="/case-studies/" style="left:50%;top:50%;text-decoration:none"><img src="/img/3d/growth.webp" alt="" width="480" height="480" loading="lazy" /><span>Your revenue</span><small>what every channel is measured by</small></a>
        {ring.map((n) => (
          <a class="node" href={'/' + n.slug + '/'} style={`left:${n.x}%;top:${n.y}%;width:17%;text-decoration:none`}>
            <img src={`/img/3d/${n.icon}.webp`} alt="" width="480" height="480" loading="lazy" />
            <span>{short[n.slug]}</span>
          </a>
        ))}
      </div>
      <div class="era">
        <div class="reveal">
          <h3>How marketing used to work</h3>
          <ul>
            <li>Separate agencies for ads, social, email and the website</li>
            <li>Each one reporting its own vanity metric: clicks, likes, opens</li>
            <li>Leads handed to sales with no follow-up system behind them</li>
            <li>Reports stitched together by hand at month end</li>
          </ul>
        </div>
        <div class="now reveal d1">
          <h3>How growth works now</h3>
          <ul>
            <li>One plan where ads, content and outreach all feed the same funnel</li>
            <li>Every channel judged by cost per customer and revenue, not reach</li>
            <li>Email and automation turn every lead into a long-term buyer</li>
            <li>AI agents research, sort, follow up and report around the clock</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">Services</span>
        <h2 data-split>What does a growth marketing agency do <em>for your revenue?</em></h2>
        <p class="lead reveal">It runs the full path from a stranger's first look to their repeat purchase. Ours covers nine services in four stages, and each one starts with a measured baseline.</p>
      </div>
      {GROUPS.map((g) => (
        <div class="stage">
          <div class="stage-head reveal"><span class="serif">{g.name}</span><p>{g.line}</p></div>
          <div class="grid3">
            {SERVICES.filter((s) => s.group === g.name).map((s, i) => (
              <a class={'svc reveal' + (s.isNew ? ' new' : '') + ' d' + (i % 3)} href={'/' + s.slug + '/'} data-tilt>
                <img class="ico" src={`/img/3d/${s.icon}.webp`} alt={`3D illustration for ${s.card.toLowerCase()} services`} width="480" height="480" loading="lazy" />
                <h3>{s.card}</h3>
                <p>{s.blurb}</p>
                <span class="from">{s.from ? `From ${usd(s.from)}` : 'Scoped to your goals'}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="background:var(--paper)">
    <div class="wrap hook flip">
      <div class="frame reveal" data-tilt>
        <span class="tag">One engine</span>
        <video muted loop playsinline preload="none" poster="/video/ai-engine-poster.webp" data-lazy aria-label="Animation of a central engine sending signals to email, social, calendar and funnel">
          <source data-src="/video/ai-engine.webm" type="video/webm" /><source data-src="/video/ai-engine.mp4" type="video/mp4" />
        </video>
      </div>
      <div>
        <span class="eyebrow">Connected channels</span>
        <h2 data-split>Every channel <em>feeds</em> the next one.</h2>
        <p class="lead reveal">An ad brings a visitor. A page captures the email. A sequence earns the sale. A post brings them back. Automation keeps it all moving and reports what each step earned. When the channels are connected, the same budget buys more revenue.</p>
        <div class="btns reveal"><a class="btn dark" href="/ai-automation/"><span class="arr" aria-hidden="true">&#8599;</span>See how we automate it</a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap hook">
      <div class="frame reveal" data-tilt>
        <span class="tag">The hidden leak</span>
        <video muted loop playsinline preload="none" poster="/video/inbox-hook-poster.webp" data-lazy aria-label="Animation of an email avoiding the spam tray and landing in the inbox">
          <source data-src="/video/inbox-hook.webm" type="video/webm" /><source data-src="/video/inbox-hook.mp4" type="video/mp4" />
        </video>
      </div>
      <div>
        <span class="eyebrow">Where revenue disappears</span>
        <h2 data-split>Most leads are lost <em>after</em> you paid for them.</h2>
        <p class="lead reveal">A slow first reply, a form that asks too much, a follow-up email that lands in spam. Each one quietly throws away the money spent on ads and content. Before we add more traffic, we find and fix the leaks.</p>
        <div class="btns reveal"><a class="btn dark" href="/funnel-audit/"><span class="arr" aria-hidden="true">&#8599;</span>Find your leaks</a></div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--paper)">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">Case studies</span>
        <h2 data-split>Revenue we have <em>grown</em> for clients.</h2>
        <p class="lead reveal">Ecommerce, B2B services, coaching, legal and agencies. Every number links to the full story with the baseline and the period it was measured over.</p>
      </div>
      <div class="grid3" style="margin-top:44px">
        {CASES.map((c, i) => (
          <article class={'card case reveal d' + (i % 3)}>
            <span class="tag">{c.client} &middot; {c.industry}</span>
            <h3><a href={'/case-studies/' + c.slug + '/'}>{c.headline}</a></h3>
            <ul class="nums">{c.results.slice(0, 3).map((r) => <li>{r.metric}: <strong>{r.value}</strong></li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap process">
      <div class="sticky">
        <span class="eyebrow">How we work</span>
        <h2 data-split>From first call to <em>measured</em> growth.</h2>
        <p class="lead reveal">The same four steps on every engagement, whether we start with one channel or all of them.</p>
        <div class="btns reveal"><a class="btn" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Start with a growth call</a></div>
      </div>
      <ol class="steps">
        <li class="reveal"><img src="/img/3d/diagnose.webp" alt="3D magnifying glass over a chart for the diagnosis step" width="480" height="480" loading="lazy" /><div><h3>Diagnose</h3><p>We read your numbers channel by channel and find where revenue is lost: traffic, conversion, follow-up or retention.</p></div></li>
        <li class="reveal"><img src="/img/3d/funnel.webp" alt="3D sales funnel with coins for the planning step" width="480" height="480" loading="lazy" /><div><h3>Plan</h3><p>You get a written plan that ranks every fix and channel by expected revenue, with the budget each one needs.</p></div></li>
        <li class="reveal"><img src="/img/3d/plane.webp" alt="3D paper plane taking off for the launch step" width="480" height="480" loading="lazy" /><div><h3>Launch</h3><p>We build and run the campaigns, content, outreach, pages and automations, with your approval on anything public.</p></div></li>
        <li class="reveal"><img src="/img/3d/growth.webp" alt="3D rising bar chart with coins for the growth step" width="480" height="480" loading="lazy" /><div><h3>Grow</h3><p>Monthly reports tie spend to revenue. Budget moves to what earns, and what does not earn is cut.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section dark" style="padding:0">
    <ul class="strip wrap" aria-label="Public Upwork record">
      <li><strong data-count="123">123</strong>Upwork jobs completed</li>
      <li><strong data-count="300" data-pre="$" data-suf="K+">$300K+</strong>earned on Upwork</li>
      <li><strong data-count="8700" data-suf="+">8,700+</strong>hours of client work</li>
      <li><strong data-count="100" data-suf="%">100%</strong>Job Success score</li>
    </ul>
  </section>

  <section class="section">
    <div class="narrow center">
      <blockquote style="margin:0" class="reveal">
        <p class="quote">"We knew marketing was powerful, but we struggled to find a partner who could address our unique pain points and help us scale sustainably. Both Barbara and Kunal simply nailed it."</p>
        <p>Debra Becker, Founder and CEO, Dimov Associates</p>
      </blockquote>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="narrow">
      <span class="eyebrow">FAQ</span>
      <h2>Questions people ask before they hire us</h2>
      <dl class="faq">{faq.map(([q, a]) => <><dt>{q}</dt><dd>{a}</dd></>)}</dl>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="cta reveal">
        <h2>Tell us your revenue goal. <em>We will show you the path.</em></h2>
        <p>Book a 20 minute call. You leave with the two or three changes most likely to grow your revenue first, whether you hire us or not.</p>
        <div class="btns"><a class="btn" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Book a 20 minute growth call</a><a class="btn ghost" href="/case-studies/" style="--fg:#fff">See case studies</a></div>
        <img class="ico" src="/img/3d/growth.webp" alt="" width="480" height="480" loading="lazy" data-parallax="0.1" />
      </div>
    </div>
  </section>
</Base>
