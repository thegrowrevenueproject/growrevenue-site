---
import Base from '../layouts/Base.astro';
import Ribbon from '../components/Ribbon.astro';
import * as si from 'simple-icons';
import { SERVICES, GROUPS, CASES, REVENUE_PROOF } from '../data/site';
import { CASE_BODY } from '../data/cases';
const Q = 'digital marketing company';
const faq: [string, string][] = [
  ['What does a digital marketing company do?', 'It plans and runs the channels that bring in customers, then judges each one by the revenue it produces. For us that means paid ads, social media, content, lead generation, email marketing, funnels and AI automation, built to feed each other instead of competing for budget.'],
  ['Why call yourselves a growth company?', 'Because the job is growth, not activity. A growth company is paid to move revenue, so every channel we run is measured by cost per customer and sales, and anything that does not earn is cut.'],
  ['How do you measure success?', 'By revenue and the numbers that lead to it: cost per lead, cost per customer, lead to sale conversion and email revenue share. Every project starts with a baseline, so the before and after are measured, not estimated.'],
  ['Do I need every service?', 'No. Most clients start with the one or two channels where the gap is biggest, often a leaking funnel or an email list that earns nothing. We add channels only when the first ones pay for themselves.'],
  ['How much does it cost?', 'Fixed-price packages start at $350 for a deliverability audit, $500 for a funnel audit and $600 for a cold email setup. Ongoing marketing is scoped to your goals after a free 20 minute call, with a fixed monthly fee.'],
  ['Where are you based?', 'London, United Kingdom. We work with businesses in the US, UK, Canada and Europe, mostly in their own time zones.'],
];
const schema = [{ '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
const ic = (k: string) => (si as any)[k]?.path as string;
const trail = ['siInstagram', 'siTiktok', 'siYoutube', 'siMeta', 'siGoogleads', 'siHubspot', 'siGmail', 'siShopify', 'siZapier', 'siN8n'].map(ic).filter(Boolean);
const floats = ['siInstagram', 'siTiktok', 'siYoutube', 'siGmail', 'siMeta'].map(ic);
const stageStyle = ['c1', 'c2', 'c3', 'c4'];
const stagePoints: Record<string, string[]> = {
  Attract: ['Google Ads', 'Meta Ads', 'TikTok', 'Instagram', 'YouTube', 'Short-form video'],
  Capture: ['Cold email', 'LinkedIn outreach', 'Lead magnets', 'Landing pages', 'Booked calls'],
  Convert: ['Funnel audits', 'Welcome flows', 'Abandoned cart', 'Win-back', 'CRM routing'],
  Scale: ['n8n', 'Make', 'Zapier', 'AI agents', 'Inbox placement', 'Reporting'],
};
const proofPics = ['team-tablet', 'team-planning', 'creator-man', 'team-strategy'];
const proofAlt = ['Marketing team reviewing an online revenue report on a tablet', 'Team planning a coaching program launch on a whiteboard', 'Creator filming an ad in front of a ring light', 'Strategy meeting about lead volume and cost per acquisition'];
const casePics: Record<string, [string, string]> = {
  'synaps-dx': ['team-desk', 'Marketer building an email campaign at a desk in an office'],
  'scalability': ['team-trio', 'Three colleagues reviewing outreach replies together on a laptop'],
  'maestro': ['creator-woman', 'Creator setting up a camera and ring light for a live stream'],
  'soulful-evolution': ['team-planning', 'Team planning a program launch together in a bright office'],
  'dimov-associates': ['team-strategy', 'Team discussing lead funnel numbers around a meeting table'],
  'austere': ['team-late', 'Team reviewing paid ad results together in the evening'],
};
const short: Record<string, string> = { 'paid-advertising': 'Paid ads', 'social-media-marketing': 'Social media', 'content-creation': 'Content', 'lead-generation': 'Lead generation', 'cold-email-infrastructure': 'Cold email', 'funnel-audit': 'Funnels', 'email-marketing': 'Email marketing', 'ai-automation': 'AI automation', 'email-deliverability': 'Deliverability' };
const flips = [
  { slug: 'synaps-dx', big: '40%', what: 'growth in online revenue', who: 'Synaps Dx', role: 'Ecommerce', quote: CASES[0].quote },
  { slug: 'scalability', big: '150+', what: 'qualified leads a month', who: 'Scalability', role: 'B2B services', quote: CASES[1].quote },
  { slug: 'dimov-associates', big: '3x', what: 'lead volume, 40% lower cost per acquisition', who: 'Dimov Associates', role: 'Legal', quote: CASES[4].quote },
  { slug: 'soulful-evolution', big: '$500K', what: 'new annual revenue', who: 'Soulful Evolution', role: 'Coaching', text: 'Program sign-ups rose 60%, with 300+ leads a month coming in across LinkedIn, Google Ads and email nurture.' },
  { slug: 'maestro', big: '+65%', what: 'creator sign-ups', who: 'Maestro', role: 'Creator platform', text: 'Segmented cold email and LinkedIn reached 200,000+ potential users at a 42% open rate.' },
  { slug: 'austere', big: '3.5x', what: 'return on ad spend', who: 'Austere', role: 'Marketing services', text: 'Ads matched to landing pages produced 450+ qualified leads in one quarter at an 18% lower cost per click.' },
];
const team = [
  { name: 'Barbara Arora', role: 'Co-founder. Client strategy, social media and campaign planning.', img: '/img/barbara-arora.webp', href: '/about/' },
  { name: 'Kunal Arora', role: 'Founder. Growth strategy, email, outreach and automation.', img: '/img/kunal-arora.webp', href: '/kunal-arora/' },
  { name: 'Rahul Arora', role: 'Creative director. Ad creative, video, design and landing pages.', img: '/img/rahul-arora.webp', href: '/about/' },
];
---
<Base title="Digital Marketing Company That Grows Revenue | Grow Revenue"
  description="A growth company and digital marketing company running paid ads, social, content, lead generation, email and AI automation as one system to grow revenue."
  path="/" pageType="home" query={Q} schema={schema} ogImage="/og/home.png">

  <!-- 1. Pinned hero: typewriter headline, icons travelling a curved path, video and people collage -->
  <section class="h2-hero" data-pin-hero>
    <svg class="trail" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path id="trailPath" class="path" d="M380 1000 C 640 900, 820 940, 1000 820 S 1240 420, 1540 180" />
      {trail.map((p, i) => (
        <g class="bub">
          <circle r="27" />
          <g transform="translate(-14 -14) scale(1.1667)"><path d={p} /></g>
          <animateMotion dur="26s" repeatCount="indefinite" begin={`-${(i * 2.6).toFixed(1)}s`}><mpath href="#trailPath" /></animateMotion>
        </g>
      ))}
    </svg>
    <div class="wrap inner grid">
      <div>
        <span class="eyebrow">A growth company &middot; London, serving the US, UK and Europe</span>
        <h1 data-split>The digital marketing company built to grow your <em data-type="revenue.|pipeline.|sales.|margins.">revenue.</em></h1>
        <p class="lead">We are a growth company: a digital marketing company that reports on revenue. Paid ads, social media, content, lead generation, email marketing, funnels and AI automation run as one system, so every channel feeds the next and you can see what each one earns.</p>
        <div class="btns">
          <a class="btn" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Book a 20 minute growth call</a>
          <a class="btn ghost" href="/case-studies/">See the revenue results</a>
        </div>
      </div>
      <div class="collage" aria-label="Our work in pictures">
        <div class="vid" data-parallax="0.06">
          <video autoplay muted loop playsinline preload="none" poster="/video/creator-poster.webp" data-lazy aria-label="Creator filming short-form video content on a phone">
            <source data-src="/video/creator.webm" type="video/webm" /><source data-src="/video/creator.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="ph" data-parallax="-0.05"><img src="/img/people/team-laptop-720.webp" srcset="/img/people/team-laptop-720.webp 720w, /img/people/team-laptop-1400.webp 1400w" sizes="(max-width: 900px) 60vw, 340px" alt="Digital marketing company team planning a client growth campaign together" width="720" height="480" fetchpriority="high" /></div>
        <div class="badge b1"><span class="ic" aria-hidden="true">&#8599;</span><span><strong>3.5x</strong>return on ad spend</span></div>
        <div class="badge b2"><span class="ic" aria-hidden="true">$</span><span><strong>$500K</strong>new annual revenue</span></div>
        <div class="badge b3"><span class="ic" aria-hidden="true">&#9993;</span><span><strong>38%+</strong>of revenue from email</span></div>
      </div>
    </div>
  </section>

  <div class="over">
    <Ribbon />

    <!-- 2. About curtain: rises over the hero, statement lights up word by word -->
    <section class="curtain" aria-labelledby="about-h">
      <div class="wrap">
        <div class="row reveal">
          <p>We help ambitious businesses grow revenue with paid ads, social media, content, outreach and email that work as one plan.</p>
          <img src="/img/people/team-trio-720.webp" alt="Three colleagues discussing a campaign plan over a laptop" width="720" height="480" loading="lazy" />
          <h2 id="about-h">About <em>us</em></h2>
          <img src="/img/people/team-late-720.webp" alt="Team working late together on client campaign reports" width="720" height="480" loading="lazy" />
          <p class="r">From the first ad to the repeat purchase, we turn attention into pipeline and pipeline into sales, one measured step at a time.</p>
        </div>
        <p class="statement" data-scrub>We are a results driven growth company. We judge every ad, post and email by <em>the revenue it brings in</em>, and we cut whatever does not earn its place.</p>
        <div class="btns"><a class="btn" href="/about/"><span class="arr" aria-hidden="true">&#8599;</span>Meet the company</a></div>
      </div>
    </section>

    <!-- 3. News-style results ticker -->
    <div class="ticker" aria-label="Recent client results">
      <span class="lab">Results</span>
      <div class="marquee">
        {[0, 1].map((dup) => (
          <div class="track" aria-hidden={dup ? 'true' : undefined}>
            <span><b>Synaps Dx</b> online revenue up 40%</span><span><b>Scalability</b> 50+ sales consultations in 3 months</span><span><b>Soulful Evolution</b> $500K new annual revenue</span><span><b>Dimov Associates</b> 3x leads at 40% lower cost</span><span><b>Austere</b> 3.5x return on ad spend</span><span><b>Maestro</b> 65% more creator sign-ups</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 4. Stat rows with zooming people images -->
    <section class="section">
      <div class="wrap">
        <span class="eyebrow">Proof</span>
        <h2 data-split>What results have <em>clients</em> seen?</h2>
        <p class="lead reveal">Four numbers from published case studies. Each one links to the full story, with the starting point and the period it was measured over.</p>
        <ul class="srows">
          {REVENUE_PROOF.map((r, i) => (
            <li class="srow reveal">
              <strong data-count={r.value} data-pre={r.pre} data-suf={r.suf} data-dec={String(r.value).includes('.') ? '1' : '0'}>{r.pre}{r.value}{r.suf}</strong>
              <p><b>{r.label}</b><a href={'/case-studies/' + r.slug + '/'}>{r.client} case study &rarr;</a></p>
              <div class="pic" data-zoom><img src={`/img/people/${proofPics[i]}-720.webp`} alt={proofAlt[i]} width="720" height="480" loading="lazy" /></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Services: heading pinned while stage cards stack over each other -->
    <section class="section" style="padding-top:0;background:var(--cream)">
      <div class="wrap stackwrap">
        <div class="stack-head center">
          <span class="eyebrow">Services</span>
          <h2 data-split>What does a digital marketing company do <em>for your revenue?</em></h2>
          <p class="lead reveal">It runs the full path from a stranger's first look to their repeat purchase. Ours covers nine services in four stages.</p>
        </div>
        <div class="stack" data-stack>
          {GROUPS.map((g, i) => (
            <article class={'stack-card ' + stageStyle[i]} style={`--i:${i}`}>
              <div>
                <span class="k">0{i + 1} {g.name}</span>
                <h3>{g.line}</h3>
                <ul class="sl">
                  {SERVICES.filter((s) => s.group === g.name).map((s) => (
                    <li><a href={'/' + s.slug + '/'}><img src={`/img/3d/${s.icon}.webp`} alt="" width="46" height="46" loading="lazy" /><span><b>{s.nav}</b><small>{s.blurb.split('. ')[0].replace(/\.$/, '')}.</small></span></a></li>
                  ))}
                </ul>
                <ul class="chips" aria-label={g.name + ' tools and tactics'}>{stagePoints[g.name].map((c) => <li>{c}</li>)}</ul>
              </div>
              <div class="mock" aria-hidden="true">
                {g.name === 'Attract' && <>
                  <div class="tile"><small>Return on ad spend</small><b>3.5x</b><span class="up">&#9650; vs last quarter</span></div>
                  <div class="tile"><small>Cost per customer</small><b>$41</b><span class="up">&#9660; 22%</span></div>
                  <div class="tile w"><small>Revenue by week</small><div class="bars"><i style="--h:30%"></i><i style="--h:44%"></i><i style="--h:38%"></i><i style="--h:56%"></i><i style="--h:62%"></i><i style="--h:58%"></i><i style="--h:74%"></i><i style="--h:88%"></i><i style="--h:96%"></i></div></div>
                  <div class="tile w"><div class="rowi"><span class="dot">G</span>Search, brand terms<span class="pill">5.1x</span></div><div class="rowi"><span class="dot">M</span>Meta, video retargeting<span class="pill">3.8x</span></div><div class="rowi"><span class="dot">T</span>TikTok, creator ads<span class="pill g">testing</span></div></div>
                </>}
                {g.name === 'Capture' && <>
                  <div class="tile"><small>Qualified leads</small><b>150+</b><span class="up">per month</span></div>
                  <div class="tile"><small>Reply rate</small><b>11.4%</b><span class="up">&#9650; 3.2 pts</span></div>
                  <div class="tile w"><small>This week's booked calls</small><div class="rowi"><span class="dot">AC</span>Head of Growth, SaaS<span class="pill">Tue 10:00</span></div><div class="rowi"><span class="dot">JR</span>Founder, law firm<span class="pill">Wed 15:30</span></div><div class="rowi"><span class="dot">MK</span>COO, ecommerce<span class="pill">Thu 09:00</span></div><div class="rowi"><span class="dot">SL</span>VP Sales, B2B<span class="pill g">confirmed</span></div></div>
                </>}
                {g.name === 'Convert' && <>
                  <div class="tile w"><small>Email share of online revenue</small><b>38%+</b><svg class="spark" viewBox="0 0 300 60" preserveAspectRatio="none"><path d="M0 55 C 40 52, 60 48, 90 44 S 150 30, 180 26 S 240 12, 300 6" /></svg></div>
                  <div class="tile"><small>Open rate</small><b>35%</b><span class="up">from 18%</span></div>
                  <div class="tile"><small>Click rate</small><b>3.2%</b><span class="up">from 1.5%</span></div>
                  <div class="tile w"><small>Live flows</small><div class="flow"><span>Sign-up</span><i></i><span>Welcome</span><i></i><span>Cart</span><i></i><span>Win-back</span></div></div>
                </>}
                {g.name === 'Scale' && <>
                  <div class="tile w"><small>AI agent: reply triage</small><div class="flow"><span>Inbox</span><i></i><span>Classify</span><i></i><span>Draft</span><i></i><span>Human OK</span><i></i><span>CRM</span></div></div>
                  <div class="tile"><small>Hours saved a week</small><b>14</b><span class="up">per team</span></div>
                  <div class="tile"><small>Inbox placement</small><b>96%</b><span class="up">Gmail and Outlook</span></div>
                  <div class="tile w"><div class="rowi"><span class="dot">n8n</span>Lead research workflow<span class="pill g">running</span></div><div class="rowi"><span class="dot">AI</span>Weekly revenue report<span class="pill">Mon 08:00</span></div></div>
                </>}
              </div>
            </article>
          ))}
        </div>
        <nav class="circles reveal" aria-label="Jump to a service">
          {SERVICES.map((s) => <a href={'/' + s.slug + '/'}><span class="c"><img src={`/img/3d/${s.icon}.webp`} alt="" width="78" height="78" loading="lazy" /></span>{short[s.slug]}</a>)}
        </nav>
        <p class="note center">Dashboard figures on the cards are illustrations of what we report. Client results are on the case study pages.</p>
      </div>
    </section>

    <!-- 6. AI era: draggable cube + then and now -->
    <section class="section dark">
      <div class="wrap">
        <div class="era2">
          <div>
            <span class="eyebrow">Marketing in the AI era</span>
            <h2 data-split>AI made marketing cheap to make. <em>Growth</em> is still hard to earn.</h2>
            <p class="lead reveal">Anyone can now produce a thousand ads, posts and emails in an afternoon, so feeds and inboxes are flooded and attention costs more every year. The businesses that grow connect every channel into one engine, use AI to do the busywork, and keep people on strategy, creative and judgment. That engine is what we build.</p>
            <div class="btns reveal"><a class="btn" href="/ai-automation/"><span class="arr" aria-hidden="true">&#8599;</span>See our AI automation</a></div>
          </div>
          <div aria-hidden="true">
            <div class="cube" data-cursor="Drag">
              <div class="c3d">
                <div class="f f1"><img src="/img/people/team-laptop-720.webp" alt="" width="720" height="480" loading="lazy" /><span>People</span></div>
                <div class="f f2 ico"><img src="/img/3d/ads.webp" alt="" width="480" height="480" loading="lazy" /><span>Paid ads</span></div>
                <div class="f f3"><img src="/img/people/creator-woman-720.webp" alt="" width="720" height="479" loading="lazy" /><span>Content</span></div>
                <div class="f f4 ico"><img src="/img/3d/ai.webp" alt="" width="480" height="480" loading="lazy" /><span>AI agents</span></div>
                <div class="f f5 ico"><img src="/img/3d/growth.webp" alt="" width="480" height="480" loading="lazy" /><span>Revenue</span></div>
                <div class="f f6 ico"><img src="/img/3d/loop.webp" alt="" width="480" height="480" loading="lazy" /><span>Email</span></div>
              </div>
            </div>
            <p class="cube-hint">Drag to turn the engine</p>
          </div>
        </div>
        <div class="era">
          <div class="reveal">
            <h3>How marketing used to work</h3>
            <ul>
              <li>Separate suppliers for ads, social, email and the website</li>
              <li>Each one reporting its own vanity metric: clicks, likes, opens</li>
              <li>Leads handed to sales with no follow-up system behind them</li>
              <li>Reports stitched together by hand at month end</li>
            </ul>
          </div>
          <div class="now reveal d1">
            <h3>How growth works now</h3>
            <ul>
              <li>One plan where ads, content and outreach all feed the same funnel</li>
              <li>Every channel judged by cost per customer and revenue, not reach</li>
              <li>Email and automation turn every lead into a long-term buyer</li>
              <li>AI agents research, sort, follow up and report around the clock</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Horizontal scroll strip: what we make -->
    <section class="hs" data-hscroll aria-labelledby="make-h">
      <div class="stick">
        <div class="wrap">
          <span class="eyebrow">Inside the work</span>
          <h2 id="make-h" data-split>What do we make <em>every month?</em></h2>
        </div>
        <div class="htrack">
          <article class="hcard"><div class="m"><span class="n">Video</span><video muted loop playsinline preload="none" poster="/video/creator-poster.webp" data-lazy aria-label="Creator recording a short video on a phone tripod"><source data-src="/video/creator.webm" type="video/webm" /><source data-src="/video/creator.mp4" type="video/mp4" /></video></div><div class="t"><h3>Short-form video</h3><p>Hooks, scripts and edits for Reels, TikTok and Shorts, planned around what your buyers search for.</p></div></article>
          <article class="hcard"><div class="m ico"><span class="n">Ads</span><img src="/img/3d/ads.webp" alt="3D illustration of a megaphone for paid ad creative" width="480" height="480" loading="lazy" /></div><div class="t"><h3>Ad creative and landing pages</h3><p>Static, video and motion ads with the page they point to, tested against cost per customer.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">Social</span><img src="/img/people/creator-man-720.webp" alt="Content creator filming himself in front of a ring light" width="720" height="480" loading="lazy" /></div><div class="t"><h3>Social content</h3><p>Carousels, posts and creator content on a calendar, with every post pointing somewhere useful.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">Email</span><video muted loop playsinline preload="none" poster="/video/inbox-hook-poster.webp" data-lazy aria-label="Animation of an email avoiding spam and landing in the inbox"><source data-src="/video/inbox-hook.webm" type="video/webm" /><source data-src="/video/inbox-hook.mp4" type="video/mp4" /></video></div><div class="t"><h3>Email flows and campaigns</h3><p>Welcome, cart, post-purchase and win-back flows that keep selling after the first order.</p></div></article>
          <article class="hcard"><div class="m ico"><span class="n">Leads</span><img src="/img/3d/magnet.webp" alt="3D magnet illustration pulling in qualified business leads" width="480" height="480" loading="lazy" /></div><div class="t"><h3>Outreach that books calls</h3><p>Lead lists, cold email and LinkedIn sequences that fill your calendar with buyers.</p></div></article>
          <article class="hcard"><div class="m"><span class="n">AI</span><video muted loop playsinline preload="none" poster="/video/ai-engine-poster.webp" data-lazy aria-label="Animation of a central engine sending signals to every channel"><source data-src="/video/ai-engine.webm" type="video/webm" /><source data-src="/video/ai-engine.mp4" type="video/mp4" /></video></div><div class="t"><h3>AI agents and automations</h3><p>Workflows that research leads, sort replies, update the CRM and write the weekly report.</p></div></article>
          <article class="hcard"><div class="m ico"><span class="n">Reports</span><img src="/img/3d/growth.webp" alt="3D rising bar chart showing revenue growth over time" width="480" height="480" loading="lazy" /></div><div class="t"><h3>Revenue reports</h3><p>One monthly report that ties spend in every channel to the sales it produced.</p></div></article>
        </div>
      </div>
    </section>

    <!-- 8. Case studies: tabs by client -->
    <section class="section">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Case studies</span>
          <h2 data-split>Real work. <em>Real revenue.</em></h2>
          <p class="lead reveal">Ecommerce, B2B services, coaching, legal and creator platforms. Pick a client to see what changed and what it earned.</p>
        </div>
        <div data-tabs>
          <div class="tabs" role="tablist" aria-label="Client case studies">
            {CASES.map((c, i) => <button role="tab" id={'t-' + c.slug} aria-controls={'p-' + c.slug} aria-selected={i === 0 ? 'true' : 'false'}>{c.client} &middot; {c.industry}</button>)}
          </div>
          {CASES.map((c, i) => (
            <div class="tpanel" role="tabpanel" id={'p-' + c.slug} aria-labelledby={'t-' + c.slug}>
              <div class="pic"><img src={`/img/people/${casePics[c.slug][0]}-720.webp`} alt={casePics[c.slug][1]} width="720" height="480" loading="lazy" /></div>
              <div class="tx">
                <span class="cl">{c.client}</span>
                <h3><a href={'/case-studies/' + c.slug + '/'}>{c.headline}</a></h3>
                <p>{CASE_BODY[c.slug]?.summary.split('. ').slice(0, 2).join('. ').replace(/\.?$/, '.')}</p>
                <ul class="statchips">{c.results.slice(0, 3).map((r) => <li>{r.metric}: <b>{r.value}</b></li>)}</ul>
                <a class="btn dark" href={'/case-studies/' + c.slug + '/'}><span class="arr" aria-hidden="true">&#8599;</span>Read the {c.client} story</a>
              </div>
            </div>
          ))}
        </div>
        <div class="marquee names" aria-hidden="true">
          {[0, 1].map(() => <div class="track">{CASES.map((c) => <span>{c.client}</span>)}<span>Upwork Top Rated Plus</span></div>)}
        </div>
      </div>
    </section>

    <!-- 9. Why: office video grows to full width, then approach list -->
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="grow" data-grow>
