---
import Base from '../layouts/Base.astro';
import Ribbon from '../components/Ribbon.astro';
import { SERVICES, GROUPS, CASES, REVENUE_PROOF, usd } from '../data/site';
import { CASE_BODY } from '../data/cases';
const Q = 'marketing company';
const faq: [string, string][] = [
  ['What does a revenue-driven marketing company do?', 'It plans and runs the channels that bring in customers, then judges each one by the revenue it produces. For us that means paid ads, social media, content, lead generation, email marketing, funnels and AI automation, built to feed each other instead of competing for budget.'],
  ['How is that different from a typical marketing supplier?', 'A typical supplier reports the metric of its own channel: clicks, followers or opens. We report revenue first and the numbers that lead to it, and we move budget away from anything that does not pay for itself.'],
  ['How do you measure success?', 'By revenue and the numbers that lead to it: cost per lead, cost per customer, lead to sale conversion and email revenue share. Every project starts with a baseline, so the before and after are measured, not estimated.'],
  ['Do I need every service?', 'No. Most clients start with the one or two channels where the gap is biggest, often a leaking funnel or an email list that earns nothing. We add channels only when the first ones pay for themselves.'],
  ['How much does it cost?', 'Fixed-price packages start at $350 for a deliverability audit, $500 for a funnel audit and $600 for a cold email setup. Ongoing marketing is scoped to your goals after a free 20 minute call, with a fixed monthly fee.'],
  ['Where are you based?', 'London, United Kingdom. We work with businesses in the US, UK, Canada and Europe, mostly in their own time zones.'],
];
const schema = [{ '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
const mark = '<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M13 51A7 7 0 0 1 20 44V51Z" fill="#2B8A5C"/><path d="M20 44A12 12 0 0 1 32 32V44Z" fill="#43C483"/><path d="M32 32A19 19 0 0 1 51 13V32Z" fill="#A6F2C8"/></svg>';
// the six faces of the revenue flywheel: channel, video, word typed into the headline, proof line
const faces = [
  { name: 'Paid ads', vid: 'ads', word: 'sales.', tag: '3.5x ROAS' },
  { name: 'Social', vid: 'creator', word: 'audience.', tag: 'Reels, TikTok' },
  { name: 'Content', vid: 'podcast', word: 'brand.', tag: 'Monthly plan' },
  { name: 'Lead gen', vid: 'leads', word: 'pipeline.', tag: '150+ leads/mo' },
  { name: 'Email', vid: 'email', word: 'repeat sales.', tag: '38%+ of revenue' },
  { name: 'AI automation', vid: 'aiwall', word: 'margins.', tag: 'Agents + flows' },
];
const svcPic: Record<string, string> = { 'paid-advertising': 'adsdesk', 'social-media-marketing': 'streamer', 'content-creation': 'editor', 'lead-generation': 'salescall', 'cold-email-infrastructure': 'b2bwindow', 'funnel-audit': 'strategists', 'email-marketing': 'emailmacro', 'ai-automation': 'aiwall', 'email-deliverability': 'wallchart' };
const svcAlt: Record<string, string> = { 'paid-advertising': 'Media buyer watching ad results climb on two monitors', 'social-media-marketing': 'Musician live streaming to followers from a home studio', 'content-creation': 'Video editor cutting a short vertical ad', 'lead-generation': 'Saleswoman booking a sales meeting on a video call', 'cold-email-infrastructure': 'Consultant on a call with a prospect by a city window', 'funnel-audit': 'Two strategists mapping funnel numbers late at night', 'email-marketing': 'Hands building an email automation flow on a laptop', 'ai-automation': 'Man watching an AI workflow map light up on a wall', 'email-deliverability': 'Team reading inbox placement results on a wall screen' };
const short: Record<string, string> = { 'paid-advertising': 'Paid ads', 'social-media-marketing': 'Social media', 'content-creation': 'Content', 'lead-generation': 'Lead generation', 'cold-email-infrastructure': 'Cold email', 'funnel-audit': 'Funnels', 'email-marketing': 'Email marketing', 'ai-automation': 'AI automation', 'email-deliverability': 'Deliverability' };
const casePic: Record<string, [string, string]> = {
  'synaps-dx': ['ecom', 'Product photo shoot for an online health brand at night'],
  'scalability': ['b2bwindow', 'B2B consultant on a sales call by a city window at night'],
  'maestro': ['streamer', 'Musician live streaming from a home studio with a ring light'],
  'soulful-evolution': ['coach', 'Coach running a small group workshop in a dark loft'],
  'dimov-associates': ['lawyer', 'Lawyer reviewing a lead report on a tablet at dusk'],
  'austere': ['artist', 'Painter checking social media results on her phone in her studio'],
};
const zzPics: [string, string][] = [['pointing', 'Team reading a rising revenue chart on a wall screen'], ['coach', 'Coach leading a small workshop group in a dark loft'], ['adsdesk', 'Media buyer watching ad performance graphs climb'], ['lawyer', 'Lawyer reading a lead report on a tablet in her office']];
const stageLine: Record<string, string> = { Attract: 'Get in front of the right buyers', Capture: 'Turn attention into leads', Convert: 'Turn leads into revenue', Scale: 'Keep it growing without more headcount' };
const flips = [
  { slug: 'synaps-dx', big: '40%', what: 'growth in online revenue', who: 'Synaps Dx', role: 'Ecommerce', quote: CASES[0].quote },
  { slug: 'scalability', big: '150+', what: 'qualified leads a month', who: 'Scalability', role: 'B2B services', quote: CASES[1].quote },
  { slug: 'dimov-associates', big: '3x', what: 'lead volume at 40% lower cost per acquisition', who: 'Dimov Associates', role: 'Legal', quote: CASES[4].quote },
];
const deck = [CASES[3], CASES[5], CASES[2]];
const team = [
  { name: 'Kunal Arora', role: 'Founder', bio: 'Growth strategy, email, outreach and automation.', img: '/img/kunal-arora.webp', href: '/kunal-arora/' },
  { name: 'Barbara Arora', role: 'Co-founder', bio: 'Client strategy, social media and campaign planning.', img: '/img/barbara-arora.webp', href: '/about/' },
  { name: 'Rahul Arora', role: 'Creative director', bio: 'Ad creative, video, design and landing pages.', img: '/img/rahul-arora.webp', href: '/about/' },
];
const first = (s: string) => s.split('. ')[0].replace(/\.?$/, '.');
---
<Base title="Revenue-Driven Marketing Company in London | Grow Revenue"
  description="The Grow Revenue Company is a revenue-driven marketing company in London running paid ads, social, content, lead generation, email and AI automation."
  path="/" pageType="home" query={Q} schema={schema} ogImage="/og/home.png">

  <!-- 1. Pinned hero. The flywheel turns one channel per stretch of scroll and types its word into the headline. Nothing slides over it. -->
  <div class="pinwrap" data-pinwrap>
    <section class="pinstage" aria-labelledby="hero-h">
      <div class="wrap hero4">
        <div>
          <p class="kick"><i aria-hidden="true"></i><span>Revenue-driven marketing.<br />London, serving the US, UK and Europe.</span></p>
          <h1 id="hero-h">The revenue-driven marketing company built to grow your <br /><span class="tw" data-cycle={faces.map((f) => f.word).join('|')}>revenue.</span><span class="caret" aria-hidden="true"></span></h1>
          <p class="lead">The Grow Revenue Company is a revenue-driven marketing company. We run paid ads, social media, content, lead generation, email marketing, funnels and AI automation as one system, and report one number first: the revenue it brings in.</p>
          <div class="btns">
            <a class="btn" href="/contact/"><span class="arr" aria-hidden="true">&#8599;</span>Book a 20 minute growth call</a>
            <a class="btn ghost" href="/case-studies/">See the revenue results</a>
          </div>
          <div class="trust">
            <span class="av"><img src="/img/kunal-arora.webp" alt="" width="34" height="34" /><img src="/img/barbara-arora.webp" alt="" width="34" height="34" /><img src="/img/rahul-arora.webp" alt="" width="34" height="34" /></span>
            <span>123 Upwork projects delivered<br />at 100% Job Success.</span>
          </div>
        </div>
        <div class="prismzone">
          <div class="prism" data-cursor="Drag" role="img" aria-label="The revenue flywheel: six short films, one per channel, paid ads, social, content, lead generation, email and AI automation, turning as you scroll">
            <div class="p3d">
              {faces.map((f, k) => (
                <div class={`pf k${k}`}>
                  <video autoplay muted loop playsinline preload="metadata" poster={`/video/pf-${f.vid}.webp`} aria-hidden="true"><source src={`/video/pf-${f.vid}.webm`} type="video/webm" /><source src={`/video/pf-${f.vid}.mp4`} type="video/mp4" /></video>
                  <span class="shade"></span>
                  <span class="tag">{f.name}<b>{f.tag}</b></span>
                </div>
              ))}
              <div class="cap t" set:html={mark} />
              <div class="cap b" />
            </div>
          </div>
          <div class="prism-floor" aria-hidden="true"></div>
          <ul class="chan" aria-label="Channels in the flywheel">{faces.map((f, k) => <li class={k === 0 ? 'on' : ''}>{f.name}</li>)}</ul>
        </div>
      </div>
      <span class="scrollcue" aria-hidden="true">SCROLL</span>
    </section>
  </div>

  <Ribbon />

  <!-- 2. Ticker, featured case carousel, drifting results strip, promo banner -->
  <section class="section" style="padding-top:0">
    <div class="ticker" aria-label="Recent client results">
      <span class="lab">Results</span>
      <div class="marquee">
        {[0, 1].map((dup) => (
          <div class="track" aria-hidden={dup ? 'true' : undefined}>
            <span><b>Synaps Dx</b> online revenue up 40%</span><span><b>Scalability</b> 50+ sales consultations in 3 months</span><span><b>Soulful Evolution</b> $500K new annual revenue</span><span><b>Dimov Associates</b> 3x leads at 40% lower cost</span><span><b>Austere</b> 3.5x return on ad spend</span><span><b>Maestro</b> 65% more creator sign-ups</span>
          </div>
        ))}
      </div>
    </div>
    <div class="wrap">
      <div class="lineh fh" data-r="up"><h2>Featured client results</h2></div>
      <div class="feat" data-carousel="6500" data-r="up" aria-roledescription="carousel" aria-label="Featured client results">
        {CASES.map((c, i) => (
          <article class={'slide' + (i === 0 ? ' on' : '')} aria-label={c.client}>
            <img src={`/img/cine/${casePic[c.slug][0]}-1600.webp`} alt={casePic[c.slug][1]} width="1600" height="1200" loading={i === 0 ? 'eager' : 'lazy'} />
            <div class="card">
              <p class="meta"><span>{c.client}</span><span>{c.industry}</span></p>
              <h3><a href={'/case-studies/' + c.slug + '/'}><span class="tt">{c.headline}</span></a><span class="caret" aria-hidden="true"></span></h3>
              <p>{first(CASE_BODY[c.slug]?.summary ?? '')}</p>
            </div>
          </article>
        ))}
        <div class="nav2"><button class="prev" type="button" aria-label="Previous result">&#8249;</button><button class="next" type="button" aria-label="Next result">&#8250;</button></div>
        <div class="bar" aria-hidden="true"><i></i></div>
      </div>
      <div class="drift" data-drift aria-label="More results">
        <div class="row">
          {[...CASES, ...CASES.slice(0, 3)].map((c) => (
            <a href={'/case-studies/' + c.slug + '/'}><span><b>{c.results[0].metric}: {c.results[0].value}</b><small>{c.client} &middot; {c.period}</small></span><img src={`/img/cine/${casePic[c.slug][0]}-800.webp`} alt="" width="64" height="64" loading="lazy" /></a>
          ))}
        </div>
      </div>
      <div class="promo" data-r="up">
        <small>FREE FOR NEW CLIENTS</small>
        <a href="/contact/"><b>Send us your site and numbers.<br />Get a written first read of your funnel.</b><span class="big">$0</span><span class="go">Get my free read &#8599;</span></a>
      </div>
    </div>
  </section>

  <!-- 3. Services as category tiles -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="center" data-r="drop">
        <span class="eyebrow">Services</span>
        <h2>Explore what we run</h2>
      </div>
      <div class="tiles" data-stagger="55">
        {SERVICES.map((s) => (
          <a href={'/' + s.slug + '/'} data-r="scale">
            <span class="im"><img src={`/img/cine/${svcPic[s.slug]}-800.webp`} alt={svcAlt[s.slug]} width="800" height="600" loading="lazy" /><img class="ic" src={`/img/3d/${s.icon}.webp`} alt="" width="46" height="46" loading="lazy" /></span>
            <span>{short[s.slug]}<small>{s.from ? `from ${usd(s.from)}` : 'scoped to you'}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Zigzag proof -->
  <section class="section" style="background:var(--paper)">
    <div class="wrap center">
      <span class="badge2" data-r="up">REAL CLIENTS. REAL REVENUE.</span>
      <h2 style="margin-top:18px" data-r="up">What revenue have clients seen?</h2>
      <ul class="zz">
        {REVENUE_PROOF.map((r, i) => (
          <li data-r="up">
            <div class={'ph' + (i % 2 ? ' r' : '')} data-r={i % 2 ? 'right' : 'left'}><img src={`/img/cine/${zzPics[i][0]}-800.webp`} alt={zzPics[i][1]} width="800" height="600" loading="lazy" /></div>
            <div class="mid">
              <strong data-count={r.value} data-pre={r.pre} data-suf={r.suf} data-dec={String(r.value).includes('.') ? '1' : '0'}>{r.pre}{r.value}{r.suf}</strong>
              <h3>{r.label}</h3>
              <p>Measured for {r.client} against a baseline taken before any work started. <a href={'/case-studies/' + r.slug + '/'}>Read the {r.client} case study</a>.</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="btns" style="justify-content:center"><a class="btn dark" href="/case-studies/"><span class="arr" aria-hidden="true">&#8599;</span>See every case study</a></div>
    </div>
  </section>

  <!-- 5. Dispatch blocks: services by stage -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">How the engine fits together</span>
      <h2 data-r="up">Four stages, nine services, one revenue number</h2>
      {GROUPS.map((g, gi) => {
        const list = SERVICES.filter((s) => s.group === g.name);
        const [lead, ...side] = list;
        return (
          <div class="dispatch">
            <div class="dhead" data-r="up"><h3>0{gi + 1} {g.name} <em>{stageLine[g.name]}</em></h3><a class="pill" href={'/' + lead.slug + '/'}>View {short[lead.slug]}</a></div>
            <div class="dgrid">
              <a class="dlead" href={'/' + lead.slug + '/'} data-r="left">
                <span class="im"><img src={`/img/cine/${svcPic[lead.slug]}-800.webp`} alt={svcAlt[lead.slug]} width="800" height="600" loading="lazy" /><img class="ic" src={`/img/3d/${lead.icon}.webp`} alt="" width="44" height="44" loading="lazy" /></span>
                <span><span class="tagl">{g.name} <span>&middot; {lead.from ? `from ${usd(lead.from)}` : 'scoped'}</span></span><h4>{lead.card}</h4><p>{lead.blurb}</p></span>
              </a>
              <div class="dside" data-r="right">
                {side.length ? side.map((s) => (
                  <a href={'/' + s.slug + '/'}><span class="im"><img src={`/img/cine/${svcPic[s.slug]}-800.webp`} alt="" width="800" height="600" loading="lazy" /></span><span><span class="tagl">{g.name} <span>&middot; {s.from ? `from ${usd(s.from)}` : 'scoped'}</span></span><b>{s.card}</b><small>{first(s.blurb)}</small></span></a>
                )) : (
                  <a href="/case-studies/"><span class="im"><img class="icn" src="/img/3d/growth.webp" alt="" width="480" height="480" loading="lazy" /></span><span><span class="tagl">Proof</span><b>See the revenue each stage produced</b><small>Six published case studies with baselines.</small></span></a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 6. About statement + the short answer for AI engines -->
  <section class="curtain" aria-labelledby="about-h">
    <div class="wrap">
      <div class="row" data-r="up">
        <p>We help ambitious businesses grow revenue with paid ads, social media, content, outreach and email that work as one plan.</p>
        <img src="/img/cine/strategists-800.webp" alt="Two strategists reviewing funnel charts late at night" width="800" height="450" loading="lazy" />
        <h2 id="about-h">About <em>us</em></h2>
        <img src="/img/cine/salescall-800.webp" alt="Saleswoman on a video call in a glass meeting room" width="800" height="604" loading="lazy" />
        <p class="r">From the first ad to the repeat purchase, we turn attention into pipeline and pipeline into sales, one measured step at a time.</p>
      </div>
      <p class="statement" data-scrub>We judge every ad, post and email by <em>the revenue it brings in</em>, and we cut whatever does not earn its place.</p>
      <div class="btns"><a class="btn" href="/about/"><span class="arr" aria-hidden="true">&#8599;</span>Meet the company</a></div>
    </div>
  </section>
  <section class="section" style="background:var(--paper)">
    <div class="narrow">
      <span class="eyebrow">The short answer</span>
      <h2 data-r="up">What is a revenue-driven marketing company?</h2>
      <p data-r="up">A revenue-driven marketing company plans, runs and reports every channel against the revenue it produces, not against clicks, followers or opens. It sets a baseline before any work starts, connects ads, content, outreach and email into one path to purchase, and moves budget to whatever earns. That is the only way we work.</p>
      <div class="table-wrap" data-r="up"><table>
        <caption>How we differ from a channel-by-channel supplier</caption>
        <thead><tr><th>Question</th><th>Channel supplier</th><th>Revenue-driven</th></tr></thead>
        <tbody>
          <tr><td>What gets reported?</td><td>Clicks, reach, followers, opens</td><td>Revenue, cost per customer, pipeline</td></tr>
          <tr><td>Who owns the gaps between channels?</td><td>Nobody</td><td>We do: one plan, one team</td></tr>
          <tr><td>When is a channel cut?</td><td>When the contract ends</td><td>When it stops paying for itself</td></tr>
          <tr><td>Who owns the accounts and data?</td><td>Often the supplier</td><td>You, always</td></tr>
        </tbody>
      </table></div>
    </div>
  </section>

  <!-- 7. Curated 2x2 + sidebar -->
  <div class="wrap cur">
    <div class="main">
      <h2 data-r="up">What do we make every month?</h2>
      <div class="grid22" data-stagger="80">
        <article data-r="scale"><a href="/content-creation/"><span class="im"><img src="/img/cine/editor-800.webp" alt="Video editor cutting a short vertical ad in a dark suite" width="800" height="450" loading="lazy" /></span><span class="tagl">Creative <span>&middot; every week</span></span><b>Ad creative, short-form video and the landing pages they point to</b></a></article>
        <article data-r="scale"><a href="/social-media-marketing/"><span class="im"><img src="/img/cine/streamer-800.webp" alt="Musician live streaming to followers from a home studio" width="800" height="604" loading="lazy" /></span><span class="tagl">Social <span>&middot; daily</span></span><b>Posts, carousels and creator content on a calendar that points somewhere</b></a></article>
        <article data-r="scale"><a href="/email-marketing/"><span class="im"><img src="/img/cine/emailmacro-800.webp" alt="Hands typing beside an email automation flow on a laptop" width="800" height="450" loading="lazy" /></span><span class="tagl">Email <span>&middot; always on</span></span><b>Welcome, cart, post-purchase and win-back flows that keep selling</b></a></article>
        <article data-r="scale"><a href="/lead-generation/"><span class="im"><img src="/img/cine/salescall-800.webp" alt="Saleswoman booking a meeting on a video call at night" width="800" height="604" loading="lazy" /></span><span class="tagl">Outreach <span>&middot; weekly</span></span><b>Lead lists, cold email and LinkedIn sequences that book sales calls</b></a></article>
      </div>
    </div>
    <aside data-r="right">
      <div>
        <h3>Watch the work</h3>
        <div class="lv"><video muted loop playsinline preload="none" poster="/video/celebrate.webp" data-lazy aria-label="A team celebrating a revenue spike on a laptop at night"><source data-src="/video/celebrate.webm" type="video/webm" /><source data-src="/video/celebrate.mp4" type="video/mp4" /></video><span class="play" aria-hidden="true">&#9654;</span></div>
        <p class="lvt">The moment the weekly revenue report comes in.</p>
      </div>
      <div>
        <h3>From the case files</h3>
        <ul class="eps">
          {CASES.slice(0, 4).map((c) => <li><a href={'/case-studies/' + c.slug + '/'}><img src={`/img/cine/${casePic[c.slug][0]}-800.webp`} alt="" width="54" height="54" loading="lazy" /><span><small>{c.industry.toUpperCase()} &middot; {c.period.toUpperCase()}</small><b>{c.client}: {c.results[0].value} {c.results[0].metric.toLowerCase()}</b></span><i aria-hidden="true">&#8599;</i></a></li>)}
        </ul>
      </div>
    </aside>
  </div>

  <!-- 8. AI era -->
  <section class="section dark">
    <div class="wrap">
      <div class="era2">
        <div>
          <span class="eyebrow">Marketing in the AI era</span>
          <h2 data-split>AI made marketing cheap to make. <em>Growth</em> is still hard to earn.</h2>
          <p class="lead" data-r="up">Anyone can now produce a thousand ads, posts and emails in an afternoon, so feeds and inboxes are flooded and attention costs more every year. The businesses that grow connect every channel into one engine, use AI for the busywork, and keep people on strategy, creative and judgment.</p>
          <div class="btns" data-r="up"><a class="btn" href="/ai-automation/"><span class="arr" aria-hidden="true">&#8599;</span>See our AI automation</a></div>
        </div>
        <div class="gyro" aria-hidden="true">
          <div class="p3d r1" data-spin="rx:70:70;ry:0:420" data-idle="ry:14"><i></i></div>
          <div class="p3d r2" data-spin="rx:-55:-55;ry:0:-360" data-idle="ry:-10"><i></i></div>
          <div class="p3d r3" data-spin="rx:10:190;rz:0:220" data-idle="rz:8"><i></i></div>
          <img src="/img/3d/ai.webp" alt="" width="480" height="480" loading="lazy" />
        </div>
      </div>
      <div class="era">
        <div data-r="left">
          <h3>How marketing used to work</h3>
          <ul><li>Separate suppliers for ads, social, email and the website</li><li>Each one reporting its own vanity metric: clicks, likes, opens</li><li>Leads handed to sales with no follow-up system behind them</li><li>Reports stitched together by hand at month end</li></ul>
        </div>
        <div class="now" data-r="right">
          <h3>How growth works now</h3>
          <ul><li>One plan where ads, content and outreach all feed the same funnel</li><li>Every channel judged by cost per customer and revenue, not reach</li><li>Email and automation turn every lead into a long-term buyer</li><li>AI agents research, sort, follow up and report around the clock</li></ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Pinned process stepper (self-contained, nothing covers it) -->
  <section class="pin" data-pin-steps aria-labelledby="proc-h">
    <div class="stick">
      <div class="wrap grid">
        <div>
          <span class="eyebrow">How we work</span>
          <h2 id="proc-h">How does working with us <em>run?</em></h2>
          <p>The same four steps on every engagement, whether we start with one channel or all of them.</p>
          <div class="snav" aria-hidden="true"><span class="pin-fill"></span><div class="sn on" data-step-nav><span>01</span>Diagnose</div><div class="sn" data-step-nav><span>02</span>Plan</div><div class="sn" data-step-nav><span>03</span>Launch</div><div class="sn" data-step-nav><span>04</span>Grow</div></div>
        </div>
        <div class="panels">
          <div class="panel on" data-step><div><h3>01 Diagnose</h3><p>We read your numbers channel by channel and find where revenue is lost: traffic, conversion, follow-up or retention.</p><ul><li>90 days of ad, CRM and email data</li><li>A test lead through your funnel, timed</li><li>Baseline for every number we will report</li></ul></div><img class="i3" src="/img/3d/diagnose.webp" alt="3D magnifying glass over a chart for the diagnosis step" width="480" height="480" loading="lazy" /></div>
